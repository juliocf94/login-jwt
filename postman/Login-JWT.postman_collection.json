{
  "info": {
    "name": "Login JWT + CRUD por roles",
    "description": "1. Ejecuta 'Login ADMIN' o 'Login VIEW': guarda el token en {{token}}.\n2. El resto de peticiones usan Bearer {{token}} (pestaña Authorization de la colección).\n\nbaseUrl: Quarkus http://localhost:8081 · Spring http://localhost:8080",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8081" },
    { "key": "token", "value": "" },
    { "key": "nuevoId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Login ADMIN (guarda token)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "pm.collectionVariables.set('token', pm.response.json().token);"
          ] } }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Login VIEW (guarda token)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.collectionVariables.set('token', pm.response.json().token);"
          ] } }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"viewer\",\n  \"password\": \"viewer123\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Login incorrecto -> 401",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"mala\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Quién soy (me)",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] } }
        }
      ]
    },
    {
      "name": "2. Contribuyentes",
      "item": [
        {
          "name": "Listar (ADMIN o VIEW)",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/contribuyentes", "host": ["{{baseUrl}}"], "path": ["api", "contribuyentes"] } }
        },
        {
          "name": "Obtener por id",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/contribuyentes/1", "host": ["{{baseUrl}}"], "path": ["api", "contribuyentes", "1"] } }
        },
        {
          "name": "Crear (solo ADMIN; VIEW -> 403)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "if (pm.response.code === 201) pm.collectionVariables.set('nuevoId', pm.response.json().id);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nit\": \"0614-999999-{{$randomInt}}-1\",\n  \"nombre\": \"Desde Postman\",\n  \"email\": \"postman@correo.com\",\n  \"tipo\": \"EMPRESA\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/contribuyentes", "host": ["{{baseUrl}}"], "path": ["api", "contribuyentes"] }
          }
        },
        {
          "name": "Actualizar (solo ADMIN)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nit\": \"0614-888888-001-1\",\n  \"nombre\": \"Editado desde Postman\",\n  \"email\": null,\n  \"tipo\": \"PERSONA\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/contribuyentes/{{nuevoId}}", "host": ["{{baseUrl}}"], "path": ["api", "contribuyentes", "{{nuevoId}}"] }
          }
        },
        {
          "name": "Eliminar (solo ADMIN)",
          "request": { "method": "DELETE", "header": [], "url": { "raw": "{{baseUrl}}/api/contribuyentes/{{nuevoId}}", "host": ["{{baseUrl}}"], "path": ["api", "contribuyentes", "{{nuevoId}}"] } }
        },
        {
          "name": "Validación -> 400",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nit\": \"\",\n  \"nombre\": \"\",\n  \"email\": \"no-es-email\",\n  \"tipo\": \"OTRO\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/contribuyentes", "host": ["{{baseUrl}}"], "path": ["api", "contribuyentes"] }
          }
        },
        {
          "name": "Sin token -> 401",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/contribuyentes", "host": ["{{baseUrl}}"], "path": ["api", "contribuyentes"] } }
        }
      ]
    }
  ]
}
